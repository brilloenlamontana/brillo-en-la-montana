# ==============================================================================
# Dockerfile para entorno de desarrollo local con Hot Reload
# ==============================================================================
FROM node:22-alpine

WORKDIR /app

# Copiar manifiestos de dependencias
COPY package*.json ./

# Instalar dependencias
RUN npm install

# Copiar el resto del código
COPY . .

# Exponer el puerto de desarrollo
EXPOSE 5174

# Iniciar servidor de desarrollo accesible externamente en puerto 5174
CMD ["npm", "run", "dev", "--", "--port", "5174"]

